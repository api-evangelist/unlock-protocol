{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unlock Locksmith Applications Pass API",
    "version": "2"
  },
  "items": [
    {
      "info": {
        "name": "Pass",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "generateAppleWalletPass",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://locksmith.unlock-protocol.com/v2/pass/:network/:lockAddress/:keyId/ios",
            "params": [
              {
                "name": "network",
                "value": "",
                "type": "path",
                "description": "Network id."
              },
              {
                "name": "lockAddress",
                "value": "",
                "type": "path",
                "description": "Lock address."
              },
              {
                "name": "keyId",
                "value": "",
                "type": "path",
                "description": "Key Id."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generate and return an Apple Wallet pass for a specified key associated with a lock."
        },
        {
          "info": {
            "name": "generateGoogleWalletPass",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://locksmith.unlock-protocol.com/v2/pass/:network/:lockAddress/:keyId/android",
            "params": [
              {
                "name": "network",
                "value": "",
                "type": "path",
                "description": "Network id."
              },
              {
                "name": "lockAddress",
                "value": "",
                "type": "path",
                "description": "Lock address."
              },
              {
                "name": "keyId",
                "value": "",
                "type": "path",
                "description": "Key Id."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generate and return a Google Wallet pass for a specified key associated with a lock."
        }
      ]
    }
  ],
  "bundled": true
}