                "description": "Lock address."
              },
              {
                "name": "jobId",
                "value": "",
                "type": "path",
                "description": "Id of the exported job."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get job result by job id"
        }
      ]
    }
  ],
  "bundled": true
}