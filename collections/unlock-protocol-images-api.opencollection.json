{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unlock Locksmith Applications Images API",
    "version": "2"
  },
  "items": [
    {
      "info": {
        "name": "Images",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "uploadImages",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://locksmith.unlock-protocol.com/v2/images/upload",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "images",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Upload images to locksmith"
        }
      ]
    }
  ],
  "bundled": true
}