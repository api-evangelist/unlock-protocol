{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unlock Locksmith Applications Lock Settings API",
    "version": "2"
  },
  "items": [
    {
      "info": {
        "name": "Lock Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getLockSettingsBySlug",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://locksmith.unlock-protocol.com/v2/lock-settings/slug/:slug",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path",
                "description": "Slug"
              }
            ]
          },
          "docs": "Get lock setting by slug"
        },
        {
          "info": {
            "name": "getLockSettings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://locksmith.unlock-protocol.com/v2/lock-settings/:network/locks/:lockAddress",
            "params": [
              {
                "name": "network",
                "value": "",
                "type": "path",
                "description": "Network id."
              },
              {
                "name": "lockAddress",
                "value": "",
                "type": "path",
                "description": "Lock address."
              }
            ]
          },
          "docs": "Get saved lock settings"
        },
        {
          "info": {
            "name": "saveLockSetting",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://locksmith.unlock-protocol.com/v2/lock-settings/:network/locks/:lockAddress",
            "params": [
              {
                "name": "network",
                "value": "",
                "type": "path",
                "description": "Network id."
              },
              {
                "name": "lockAddress",
                "value": "",
                "type": "path",
                "description": "Lock address."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Save lock settings"
        }
      ]
    }
  ],
  "bundled": true
}